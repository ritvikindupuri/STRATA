# Supabase Configuration
# Get these values from your Supabase project settings at https://supabase.com/dashboard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-public-key-here

# Frontend Environment Variables (exposed to client)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key-here
VITE_SUPABASE_PROJECT_ID=your-project-id

# Lovable AI Gateway (server-side only, never expose to client)
LOVABLE_API_KEY=your-lovable-api-key-here

# Optional: Encryption key for AWS secrets (auto-generated if not provided)
# ENCRYPTION_KEY=base64-encoded-32-byte-key

# SECURITY: CORS allowed origins (comma-separated, FAILS CLOSED if not set)
# Example for production: ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
# Example for development: ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:3000
